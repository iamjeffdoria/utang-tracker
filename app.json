{
  "expo": {
    "name": "Owvio",
    "slug": "utang-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/owvio2.png",
    "scheme": "utangtracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/owvio2.png",
      "backgroundColor": "#E6F4FE"
    },
    "edgeToEdgeEnabled": true,
    "predictiveBackGestureEnabled": false,
    "package": "com.jepjepbieber.utangtracker",
     "softwareKeyboardLayoutMode": "pan"
  },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/owvio2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "@clerk/expo",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32d74627-b24c-47f7-80e7-a4b3746908e6"
      }
    }
  }
}
